<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Roslyn loads analyzers into a netstandard2.0 context; this is not negotiable. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- Build-time only: never shipped, never referenced by consumers. -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!--
      RS2008 asks every analyzer to maintain AnalyzerReleases.*.md files. That is for
      analyzers shipped as standalone NuGet packages; this generator is an internal
      build step of one repository, so the tracking files would be pure ceremony.
    -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
